{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && auth.uid === $uid",
        ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && root.child('admins').child(auth.uid).val() === true && !(auth.uid === $uid && newData.val() !== true)",
        ".validate": "newData.isBoolean()"
      }
    },
    "config": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous'",
      ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && root.child('admins').child(auth.uid).val() === true",
      "price": {
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
      },
      "currency": {
        ".validate": "newData.isString() && newData.val().length <= 8"
      },
      "notice": {
        ".validate": "newData.isString() && newData.val().length <= 400"
      },
      "bkash": {
        "$k": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        }
      },
      "nagad": {
        "$k": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        }
      },
      "bank": {
        "$k": {
          ".validate": "newData.isString() && newData.val().length <= 160"
        }
      },
      "support": {
        "$k": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        }
      },
      "$other": {
        ".validate": false
      }
    },
    "profiles": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && auth.uid === $uid",
        ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && auth.uid === $uid",
        ".validate": "newData.hasChildren(['createdAt', 'email'])",
        "createdAt": {
          ".validate": "(!data.exists() && newData.val() === now) || (data.exists() && newData.val() === data.val())"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 200 && newData.val() === auth.token.email"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "phone": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "business": {
          ".validate": "newData.isString() && newData.val().length <= 160"
        },
        "lastSeen": {
          ".validate": "newData.isNumber() && newData.val() <= now + 86400000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "subs": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['expiresAt'])",
        "expiresAt": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 631152000000"
        },
        "plan": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() >= now - 86400000 && newData.val() <= now + 86400000"
        },
        "note": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "payments": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        "$pid": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && ((auth.uid === $uid && !data.exists() && $pid.matches(/^[A-Za-z0-9_-]{1,40}$/)) || root.child('admins').child(auth.uid).val() === true)",
          ".validate": "newData.hasChildren(['method', 'amount', 'years', 'trxId', 'status', 'createdAt'])",
          "method": {
            ".validate": "(newData.val() === 'bkash' || newData.val() === 'nagad' || newData.val() === 'bank') && (!data.exists() || newData.val() === data.val())"
          },
          "amount": {
            ".validate": "(newData.isNumber() && newData.val() > 0 && newData.val() <= 10000000) && (!data.exists() || newData.val() === data.val())"
          },
          "years": {
            ".validate": "(newData.isNumber() && newData.val() >= 1 && newData.val() <= 10 && newData.val() % 1 === 0) && (!data.exists() || newData.val() === data.val())"
          },
          "trxId": {
            ".validate": "(newData.isString() && newData.val().length >= 4 && newData.val().length <= 40) && (!data.exists() || newData.val() === data.val())"
          },
          "sender": {
            ".validate": "(newData.isString() && newData.val().length <= 60) && (!data.exists() || newData.val() === data.val())"
          },
          "note": {
            ".validate": "(newData.isString() && newData.val().length <= 300) && (!data.exists() || newData.val() === data.val())"
          },
          "email": {
            ".validate": "(newData.isString() && newData.val().length <= 200) && (!data.exists() || newData.val() === data.val())"
          },
          "createdAt": {
            ".validate": "(!data.exists() && newData.val() === now) || (data.exists() && newData.val() === data.val())"
          },
          "status": {
            ".validate": "(!data.exists() && newData.val() === 'pending') || (data.exists() && data.val() !== 'approved' && (newData.val() === 'pending' || newData.val() === 'approved' || newData.val() === 'rejected')) || (data.val() === 'approved' && newData.val() === 'approved')"
          },
          "reviewedAt": {
            ".validate": "newData.isNumber() && newData.val() >= now - 86400000 && newData.val() <= now + 86400000"
          },
          "adminNote": {
            ".validate": "newData.isString() && newData.val().length <= 300"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "kfm": {
      "$uid": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && auth.uid === $uid",
        ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && auth.uid === $uid && (root.child('admins').child(auth.uid).val() === true || root.child('subs').child($uid).child('expiresAt').val() > now)",
        "entries": {
          ".validate": "newData.isString() && newData.val().length < 8000000"
        },
        "extra": {
          ".validate": "newData.isString() && newData.val().length < 8000000"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "deleted": {
          ".validate": true
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}